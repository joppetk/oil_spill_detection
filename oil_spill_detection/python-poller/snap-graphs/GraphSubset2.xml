  <node id="Terrain-Correction">
    <operator>Terrain-Correction</operator>
    <sources>
      <sourceProduct refid="Speckle-Filter"/>
    </sources>
    <parameters class="com.bc.ceres.binding.dom.XppDomElement">
    <sourceBands>Sigma0_VH,Sigma0_VV</sourceBands>
      <!-- Output grid / projection -->
      <!-- Using full WKT as shown in your UI; EPSG:4326 would also work -->
      <mapProjection>GEOGCS["WGS84(DD)",DATUM["WGS84",SPHEROID["WGS84",6378137.0,298.257223563]],PRIMEM["Greenwich",0.0],UNIT["degree",0.017453292519943295]]</mapProjection>
      <alignToStandardGrid>false</alignToStandardGrid>
      <standardGridOriginX>0.0</standardGridOriginX>
      <standardGridOriginY>0.0</standardGridOriginY>

      <!-- Pixel spacing & the derived degree spacing (shown by SNAP UI) -->
      <pixelSpacingInMeter>10.0</pixelSpacingInMeter>
      <!-- pixelSpacingInDegree is computed by SNAP, but you can keep it -->
      <pixelSpacingInDegree>8.983152841195215E-5</pixelSpacingInDegree>

      <!-- Resampling -->
      <imgResamplingMethod>BILINEAR_INTERPOLATION</imgResamplingMethod>
      <demResamplingMethod>BILINEAR_INTERPOLATION</demResamplingMethod>

      <!-- DEM settings -->
      <demName>GETASSE30</demName> 
      <externalDEMNoDataValue>0.0</externalDEMNoDataValue>
      <externalDEMApplyEGM>true</externalDEMApplyEGM>
      <auxFile>Latest Auxiliary File</auxFile>

      <!-- Incidence-angle options -->
      <incidenceAngleForSigma0>Use projected local incidence angle from DEM</incidenceAngleForSigma0>
      <incidenceAngleForGamma0>Use projected local incidence angle from DEM</incidenceAngleForGamma0>

      <!-- Radiometry & saves: match screenshot (all false except saveSelectedSourceBand) -->
      <applyRadiometricNormalization>false</applyRadiometricNormalization>
      <saveSelectedSourceBand>true</saveSelectedSourceBand>
      <saveDEM>false</saveDEM>
      <saveLatLon>false</saveLatLon>
      <saveIncidenceAngleFromEllipsoid>false</saveIncidenceAngleFromEllipsoid>
      <saveProjectedLocalIncidenceAngle>false</saveProjectedLocalIncidenceAngle>
      <saveLocalIncidenceAngle>false</saveLocalIncidenceAngle>
      <saveGammaNought>false</saveGammaNought>
      <saveBetaNought>false</saveBetaNought>
      <saveSigmaNought>false</saveSigmaNought>
      <saveLayoverShadowMask>false</saveLayoverShadowMask>

      <!-- Sea handling (your screenshot shows false) -->
      
    </parameters>
  </node>


  <node id="Land-Sea-Mask">
    <operator>Land-Sea-Mask</operator>
    <sources>
      <sourceProduct refid="Terrain-Correction"/>
    </sources>
    <parameters class="com.bc.ceres.binding.dom.XppDomElement">
      <sourceBands>Sigma0_VH,Sigma0_VV</sourceBands>
      <landMask>true</landMask>
      <useSRTM>true</useSRTM>
      <geometry/>
      <invertGeometry>false</invertGeometry>
      <shorelineExtension>0</shorelineExtension>
    </parameters>
  </node>





  <node id="LinearToFromdB">
    <operator>LinearToFromdB</operator>
    <sources>
      <sourceProduct refid="Land-Sea-Mask"/>
    </sources>
    <parameters class="com.bc.ceres.binding.dom.XppDomElement">
      <sourceBands>Sigma0_VH,Sigma0_VV</sourceBands>
    </parameters>
  </node>


  <node id="Write">
    <operator>Write</operator>
    <sources>
      <sourceProduct refid="LinearToFromdB"/>
    </sources>
    <parameters class="com.bc.ceres.binding.dom.XppDomElement">
      <file>${out}</file>
      <formatName>GeoTIFF-BigTIFF</formatName>
    </parameters>
  </node>
